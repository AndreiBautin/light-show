# Every variable here is optional. Values prefixed VITE_ are compiled into the
# public bundle — never put a credential in one.

# Log level: debug | info | warn | error. Invalid values fall back to "info".
VITE_LOG_LEVEL=info

# Maximum full-screen flashes per second (photosensitivity guard).
# Clamped to 1..3; invalid values fall back to 3 (WCAG 2.3.1 limit).
VITE_MAX_FLASHES_PER_SECOND=3

# Commit SHA shown in the panel as "build abc1234". Set by the deploy
# workflow; leave unset locally. Anything that is not a hex SHA is ignored.
# VITE_COMMIT=

# Build-time only (not VITE_, never reaches the page's code):
# BASE_PATH  path the site is served under, e.g. /light-show/ on Pages
# SITE_URL   absolute site URL, used for the share card (og:image)
