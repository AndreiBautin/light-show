# Every variable here is optional. Values prefixed VITE_ are compiled into the
# public bundle — never put a credential in one.

# Log level: debug | info | warn | error. Invalid values fall back to "info".
VITE_LOG_LEVEL=info

# Maximum full-screen flashes per second (photosensitivity guard).
# Clamped to 1..3; invalid values fall back to 3 (WCAG 2.3.1 limit).
VITE_MAX_FLASHES_PER_SECOND=3
